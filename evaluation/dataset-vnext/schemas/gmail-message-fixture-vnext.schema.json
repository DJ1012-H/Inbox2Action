{
  "$defs": {
    "GmailAttachmentFixtureVNext": {
      "additionalProperties": false,
      "properties": {
        "attachment_id": {
          "maxLength": 96,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,95}$",
          "title": "Attachment Id",
          "type": "string"
        },
        "content_included": {
          "const": false,
          "default": false,
          "title": "Content Included",
          "type": "boolean"
        },
        "filename": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "mime_type": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Mime Type",
          "type": "string"
        },
        "size": {
          "maximum": 25000000,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "attachment_id",
        "filename",
        "mime_type",
        "size"
      ],
      "title": "GmailAttachmentFixtureVNext",
      "type": "object"
    },
    "GmailHeaderFixtureVNext": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "GmailHeaderFixtureVNext",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attachments": {
      "items": {
        "$ref": "#/$defs/GmailAttachmentFixtureVNext"
      },
      "title": "Attachments",
      "type": "array"
    },
    "body_data_base64url": {
      "title": "Body Data Base64Url",
      "type": "string"
    },
    "dataset_version": {
      "const": "inbox2action-vnext-candidate-1",
      "default": "inbox2action-vnext-candidate-1",
      "title": "Dataset Version",
      "type": "string"
    },
    "fixture_id": {
      "maxLength": 96,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,95}$",
      "title": "Fixture Id",
      "type": "string"
    },
    "gmail_message_id": {
      "maxLength": 96,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,95}$",
      "title": "Gmail Message Id",
      "type": "string"
    },
    "gmail_thread_id": {
      "maxLength": 96,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,95}$",
      "title": "Gmail Thread Id",
      "type": "string"
    },
    "headers": {
      "items": {
        "$ref": "#/$defs/GmailHeaderFixtureVNext"
      },
      "title": "Headers",
      "type": "array"
    },
    "history_id": {
      "pattern": "^[0-9]+$",
      "title": "History Id",
      "type": "string"
    },
    "internal_date_ms": {
      "minimum": 1,
      "title": "Internal Date Ms",
      "type": "integer"
    },
    "label_ids": {
      "items": {
        "type": "string"
      },
      "title": "Label Ids",
      "type": "array"
    },
    "mime_type": {
      "enum": [
        "text/plain",
        "text/html",
        "multipart/alternative"
      ],
      "title": "Mime Type",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic_only": {
      "const": true,
      "default": true,
      "title": "Synthetic Only",
      "type": "boolean"
    }
  },
  "required": [
    "fixture_id",
    "gmail_message_id",
    "gmail_thread_id",
    "history_id",
    "internal_date_ms",
    "label_ids",
    "headers",
    "mime_type",
    "body_data_base64url",
    "attachments"
  ],
  "title": "GmailApiMessageFixtureVNext",
  "type": "object"
}
