# Safe template for local Docker Compose configuration.
# Copy to .env for Compose. For a host process, copy to
# %LOCALAPPDATA%\Inbox2Action\secrets\runtime.env and change the database host
# in INBOX2ACTION_DATABASE_URL from postgres to localhost. Never commit either
# file and never put real credentials here.
# Set LLM_ENABLED=true only for an explicitly approved live-model run.
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-v4-flash
LLM_THINKING_MODE=disabled
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=2048
LLM_MAX_TOOL_STEPS=6
RUN_DEEPSEEK_INTEGRATION_TESTS=false

# PostgreSQL (local/demo values only; change the password in your ignored .env)
POSTGRES_DB=inbox2action
POSTGRES_USER=inbox2action
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_PORT=5432
INBOX2ACTION_DATABASE_URL=postgresql://inbox2action:replace-with-local-development-password@postgres:5432/inbox2action
RUN_POSTGRES_INTEGRATION_TESTS=false

# Compose-only host paths for the read-only Gmail OAuth client and refresh token.
# The target paths inside the containers are the Settings values below.
GMAIL_CLIENT_SECRETS_HOST_PATH=./secrets/gmail-oauth-client.json
GMAIL_TOKEN_HOST_PATH=./secrets/gmail-token.json

# External Gmail OAuth files. Fill these only in the external runtime.env.
GMAIL_CLIENT_SECRETS_PATH=/run/inbox2action/gmail-oauth-client.json
GMAIL_TOKEN_PATH=/run/inbox2action/gmail-token.json

# Stage 8 Google Calendar (trusted runtime configuration; keep credentials outside Git)
INBOX2ACTION_BUSINESS_TIMEZONE=Asia/Shanghai
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEOUT_SECONDS=30
RUN_GOOGLE_CALENDAR_INTEGRATION_TESTS=false

# Stage 7 ClickUp
CLICKUP_ENABLED=false
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_TIMEOUT_SECONDS=10
RUN_CLICKUP_INTEGRATION_TESTS=false
