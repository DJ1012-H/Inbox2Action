# Safe template for the external file:
# %LOCALAPPDATA%\Inbox2Action\secrets\runtime.env
# Create that file manually. Never commit it, and never put real credentials here.
# Set LLM_ENABLED=true only for an explicitly approved live-model run.
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-v4-flash
LLM_THINKING_MODE=disabled
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=2048
LLM_MAX_TOOL_STEPS=6
RUN_DEEPSEEK_INTEGRATION_TESTS=false

# Stage 4/6 local PostgreSQL (Docker Compose defaults; development only)
POSTGRES_DB=inbox2action
POSTGRES_USER=inbox2action
POSTGRES_PASSWORD=inbox2action_dev
POSTGRES_PORT=5432
INBOX2ACTION_DATABASE_URL=postgresql://inbox2action:inbox2action_dev@localhost:5432/inbox2action
RUN_POSTGRES_INTEGRATION_TESTS=false

# External Gmail OAuth files. Fill these only in the external runtime.env.
GMAIL_CLIENT_SECRETS_PATH=
GMAIL_TOKEN_PATH=

# Stage 7 ClickUp
CLICKUP_ENABLED=false
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_TIMEOUT_SECONDS=10
RUN_CLICKUP_INTEGRATION_TESTS=false
